# Nova — muhit o'zgaruvchilari namunasi
#
# DIQQAT: bu fayl avtomatik o'qilmaydi (python-dotenv o'rnatilmagan).
# Mahalliy ishlash uchun hech narsa kerak emas — sozlamalar o'zi ishlaydi.
# Serverda quyidagilarni eksport qiling yoki deploy platformasida kiriting:
#
#   export DJANGO_DEBUG=0
#   export DJANGO_SECRET_KEY="..."
#
# Yangi kalit yaratish:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

# DEBUG=0 bo'lganda DJANGO_SECRET_KEY majburiy, aks holda sayt ishga tushmaydi.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=bu-yerga-yangi-kalit-qo-ying

# Vergul bilan ajratilgan domenlar.
DJANGO_ALLOWED_HOSTS=nova.uz,www.nova.uz

# HTTPS orqasidagi formalar uchun (sxema bilan birga).
DJANGO_CSRF_TRUSTED_ORIGINS=https://nova.uz,https://www.nova.uz

# Ma'lumotlar bazasi — ko'rsatilmasa mahalliy sqlite ishlatiladi.
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=nova
# DJANGO_DB_USER=nova
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=5432
